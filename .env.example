# ------------------------------------------------------------------------------
# Jumanji: A Última Fase — variáveis de ambiente
# Copie este arquivo para .env (apenas para referência; o app lê do ambiente).
# ------------------------------------------------------------------------------

# Porta HTTP do servidor (o Render define automaticamente).
PORT=3000

# String de conexão do PostgreSQL.
# Se ficar vazia, o app usa SQLite local em ./data/jumanji.db (ótimo para
# desenvolvimento). Em produção (Render) defina a URL do banco.
DATABASE_URL=

# Em produção use "production" para habilitar cache de assets.
NODE_ENV=development

# Cria as fases da história e os aventureiros de exemplo quando o banco está
# vazio (true/false).
SEED=true

# Diretório do arquivo SQLite local (opcional).
# DATA_DIR=./data
